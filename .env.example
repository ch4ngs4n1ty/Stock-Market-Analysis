# Server
PORT=3000
NODE_ENV=development

# Financial Modeling Prep (FMP) — PRIMARY fundamentals source.
# Sign up: https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# Finnhub — used ONLY for realtime quote, news, and (optional) market updates.
# Sign up: https://finnhub.io/register (free tier works)
FINNHUB_API_KEY=

# Optional Alpha Vantage key — fallback for historical daily candles when Finnhub
# denies access. Get one here: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=YOUR_ALPHA_VANTAGE_API_KEY_HERE

# Optional Hugging Face token — enables FinBERT sentiment on /api/v1/nlp/:symbol.
# Without it, the NLP scorer falls back to a finance-news lexicon (still works).
# Get one here: https://huggingface.co/settings/tokens (free)
HUGGINGFACE_API_KEY=
